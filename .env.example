# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit real secrets.

# ── Required ──────────────────────────────────────────────────────────────
# Postgres connection string (e.g. Neon). App throws on boot if missing.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── AI features (chat / export) ───────────────────────────────────────────
# OpenAI API key. App boots without it, but AI calls will fail.
OPENAI_API_KEY=sk-...

# ── Automations external API ──────────────────────────────────────────────
AUTOMATIONS_API_URL=https://automations.api.autogrc.cloud/
NEXT_PUBLIC_AUTOMATIONS_API_URL=https://automations.api.autogrc.cloud/

# ── Framework / SOC scheduler API ─────────────────────────────────────────
# Base URL used by the framework and soc pages.
NEXT_PUBLIC_SCHEDULER_API_BASE=https://scheduler.api.example.com

# ── Auth (self-hosted) ────────────────────────────────────────────────────
# Secret used to sign session JWTs. Set a long random value in production.
# Falls back to a built-in dev default if unset (do NOT rely on that in prod).
AUTH_SECRET=change-me-to-a-long-random-string
# Seed admin created by `node scripts/migrate.mjs` (login works immediately).
SEED_ADMIN_EMAIL=sbd@autogrc.local
SEED_ADMIN_PASSWORD=WeMakeGoodRAG
SEED_ADMIN_NAME=SBD Admin

# ── Email (OPTIONAL) ──────────────────────────────────────────────────────
# If set, invites & magic-links are emailed via the Resend HTTP API.
# If unset, the invite link is returned in the UI for the admin to copy/share
# (zero external dependency — works out of the box for the POC).
RESEND_API_KEY=
EMAIL_FROM=AutoGRC <onboarding@resend.dev>
