# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit real secrets.

# ── Required ──────────────────────────────────────────────────────────────
# Postgres connection string (e.g. Neon). App throws on boot if missing.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── AI features (chat / export) ───────────────────────────────────────────
# OpenAI API key. App boots without it, but AI calls will fail.
OPENAI_API_KEY=sk-...

# ── Automations external API ──────────────────────────────────────────────
AUTOMATIONS_API_URL=https://automations.api.autogrc.cloud/
NEXT_PUBLIC_AUTOMATIONS_API_URL=https://automations.api.autogrc.cloud/

# ── Framework / SOC scheduler API ─────────────────────────────────────────
# Base URL used by the framework and soc pages.
NEXT_PUBLIC_SCHEDULER_API_BASE=https://scheduler.api.example.com

# ── Authentication: AutoX ID (SSO / OpenID Connect) ───────────────────────
# Register this app in the AutoX ID admin board to obtain client_id/secret.
#   Redirect URI (register byte-for-byte):  <APP_URL>/api/auth/callback/autox
#   Post-logout redirect URI:               <APP_URL>/
# Create + assign these roles to users in AutoX ID (highest privilege wins):
#   admin | compliance_lead | assessor | viewer
AUTOX_CLIENT_ID=
AUTOX_CLIENT_SECRET=
# OIDC issuer (discovery). Defaults to https://sso.autogrc.cloud if unset.
AUTOX_ISSUER=https://sso.autogrc.cloud

# Secret Auth.js uses to encrypt the session cookie. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Public base URL of this app. In dev Auth.js infers it from the request; set
# this in production (must be https and match the registered redirect origin).
# AUTH_URL=https://your-app.example.com
